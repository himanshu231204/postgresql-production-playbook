# Copy to .env (git-ignored) and replace every placeholder.
# Used by compose.dev.yaml. Placeholders only: never commit real values.

# --- Image ---
# Pin an explicit major version. Never use :latest.
# For PostgreSQL 18+ the data mount path changes: see ../persistent-volumes.md
POSTGRES_IMAGE=postgres:16

# --- Database bootstrap (applied only when the data volume is EMPTY) ---
POSTGRES_USER=app_admin
POSTGRES_DB=appdb
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DEV_PASSWORD

# --- Application connection string (SQLAlchemy 2.x + asyncpg driver) ---
# Use a non-superuser application role in real environments.
# Host "db" is the compose service name, reachable on the compose network.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@db:5432/DATABASE
