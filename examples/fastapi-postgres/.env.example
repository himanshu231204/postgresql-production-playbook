# Copy to .env (git-ignored). Never commit real values.
# Application role from 06-security/least-privilege.md (CRUD only).
DATABASE_URL=postgresql+asyncpg://app_api:CHANGE_ME@localhost:5432/appdb

# Pool (per process): worst case connections = workers x (POOL_SIZE + MAX_OVERFLOW)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800

# Timeouts
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=15000

# TLS: path to the CA that signed the server certificate. When set, the app
# verifies the certificate AND the host name (equivalent to verify-full).
# DB_SSL_CA_FILE=/etc/ssl/certs/db-ca.pem

# PgBouncer in transaction mode with prepared statements NOT tracked:
# DB_USE_NULL_POOL=true
# DB_DISABLE_STATEMENT_CACHE=true
