# Fake placeholders only. Copy to .env (git-ignored) and edit.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

# Must equal the vector(N) size in schema.sql AND the output size of the
# embedding model. The bundled stub produces EMBEDDING_DIM-sized vectors.
EMBEDDING_DIM=384

# Chunking (characters; illustrative defaults, tune against your corpus)
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Retrieval
TOP_K=4
