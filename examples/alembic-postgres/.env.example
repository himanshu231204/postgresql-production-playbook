# Copy to .env (git-ignored) and export, or set in your deploy pipeline.
# Placeholders only. Never commit real credentials.

# Migration role (owns schema "app"; DDL). Used ONLY by Alembic / the deploy pipeline.
MIGRATION_DATABASE_URL=postgresql+asyncpg://migration_owner:PASSWORD@HOST:5432/appdb

# Optional guard rails applied to every migration session (milliseconds).
# lock_timeout: fail fast instead of queueing behind a long transaction.
# statement_timeout: illustrative default; 0 disables. Raise for large index builds.
MIGRATION_LOCK_TIMEOUT_MS=5000
MIGRATION_STATEMENT_TIMEOUT_MS=300000
